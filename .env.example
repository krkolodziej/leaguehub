# Local development values only. Never commit a real .env file.
#
# For the managed (Railway) deployment see the "Production environment" table in
# the README; that target uses DATABASE_URL instead of the POSTGRES_* variables
# below, and requires a different set of DJANGO_* values.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=stage-02-local-only-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Development falls back to the CORS origins when these are unset, so the Vite
# dev server works without them. Production requires them explicitly.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- PostgreSQL (Compose) ---
# A DATABASE_URL, when present, overrides every POSTGRES_* value here.
POSTGRES_DB=leaguehub
POSTGRES_USER=leaguehub
POSTGRES_PASSWORD=leaguehub-local
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432

# --- Redis, Celery (Compose) ---
REDIS_HOST_PORT=6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# --- Frontend (Vite, build time) ---
# The account offered behind the one-click button on the sign-in screen.
# Build with an empty VITE_DEMO_EMAIL to hide that block entirely.
VITE_DEMO_EMAIL=demo@leaguehub.app
VITE_DEMO_PASSWORD=demo1234
