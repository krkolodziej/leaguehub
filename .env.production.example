# Values for the managed single-service deployment (Railway) and for the
# nginx-fronted local production Compose profile. Replace every secret.
#
# The managed target needs only the DJANGO_* block plus DATABASE_URL; the
# platform injects DATABASE_URL and PORT for you. The POSTGRES_*/REDIS_* block
# below is what compose.production.yml uses instead.

# --- Required everywhere ---
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
# The public hostname, no scheme. Railway: <service>.up.railway.app
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# The public origin, with scheme. Must match the browser's address bar exactly.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080

# --- Required only when the SPA is served from a different origin ---
# The managed image serves the SPA and the API together, so this stays empty
# there. compose.production.yml needs it because nginx fronts the API.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:8080

# --- TLS-dependent flags ---
# Leave these at their secure defaults (unset) behind real HTTPS. They are set
# to false here only because the local Compose profile serves plain HTTP.
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_HSTS_SECONDS=0

# --- Managed database ---
# Railway provides this; reference it as ${{Postgres.DATABASE_URL}}.
# When set it overrides every POSTGRES_* value below.
# DATABASE_URL=postgresql://user:password@host:5432/railway

# --- Optional ---
# Without REDIS_URL the deployment fans live match updates out in-process and
# runs notification tasks inline. Set it, add a worker, and only then raise
# WEB_CONCURRENCY above 1.
# REDIS_URL=redis://default:password@host:6379
# WEB_CONCURRENCY=1
# DJANGO_LOG_LEVEL=INFO

# --- compose.production.yml only ---
POSTGRES_DB=leaguehub
POSTGRES_USER=leaguehub
POSTGRES_PASSWORD=replace-with-a-local-database-password
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=8080
